# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se commitea. Los valores reales se sacan del panel de Supabase.

# Publicas: viajan al navegador. Nunca pongas aqui nada sensible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Jamas con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Origenes permitidos para peticiones que mutan estado, separados por coma.
ALLOWED_ORIGINS=http://localhost:3000

# Base de los enlaces que genera el script de alta de usuarios.
APP_URL=http://localhost:3000

# Solo para aplicar migraciones con el CLI desde tu maquina. No se usan en la aplicacion
# ni en Vercel. El token se crea en Account > Access Tokens y se puede revocar.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
